# Caddyfile WITHOUT JA4+ fingerprinting, for operators who cannot accept the
# FoxIO License 1.1 commercial-use restriction (see NOTICE).
#
# Use this with a stock `caddy:2.8-alpine` image instead of building
# caddy/Dockerfile. The app degrades cleanly: `ja4` and `ja4h` are recorded as
# empty strings and every other field is unchanged. analyze.py never reads those
# two fields, so no part of the shipped report is affected.
#
#   docker compose -f docker-compose.nofingerprint.yml up -d --build
# It must not share a network namespace or a site block with anything else you
# run (SPEC §2 isolation requirement).
{
	servers {
		# Bound slow-body ("slowloris"-style) connections at the edge, the
		# app's own body-read cap (main.py's _read_capped_body) bounds bytes
		# but not time, so a trickling upload could otherwise hold a
		# connection (and, on this single-worker service, real capacity)
		# open indefinitely. `timeouts` is a global-only option (spans all
		# sites), it cannot be set inside a site block.
		timeouts {
			read_body 15s
			read_header 10s
		}
	}
}

# Placeholder hostname, rewritten to the real registered domain by deploy.sh
# at deploy time. Never commit the hostname you actually serve: publishing it
# ties the bait surface to you, and SPEC §2 asks for a name with no association
# to anything else you operate.
http-bait.example.com {
	encode gzip
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		# NOTE: deliberately NOT stripping Server/X-Powered-By here (unlike the
		# other two Caddyfiles), the app sets those headers on purpose to
		# advertise a fake vulnerable version (SPEC §4.3); stripping them here
		# would silently defeat that bait.
	}
	log {
		output file /var/log/caddy/access.log {
			roll_size 50mb
			roll_keep 10
		}
		format json
	}
	reverse_proxy app:8100 {
		header_up X-Forwarded-For {remote_host}
		header_up X-JA4 {http.vars.ja4}
		header_up X-TLS-Version {http.request.tls.version}
		header_up X-TLS-Cipher {http.request.tls.cipher_suite}
		header_up X-TLS-SNI {http.request.tls.server_name}
		header_up X-TLS-ALPN {http.request.tls.proto}
		flush_interval -1
	}
}