# Deployment-specific documents. Templates are tracked; the copy you actually
# fill in carries a .local.md suffix and is never committed. A tracked file
# cannot be gitignored, which is why the filled copy needs its own name rather
# than an ignore rule on the template.
*.local.md

# Runtime telemetry. Contains third-party IP addresses — never commit.
data/
*.jsonl

# The one exception: fixtures/ is entirely synthetic (RFC 5737 documentation
# addresses, invented token ids) and is what CI diffs the analyzer against.
# Keep this exception narrow, and never move a real log into this directory.
!fixtures/*.jsonl

# Deploy-time artifacts generated by deploy.sh from the templates. They embed the
# real hostname of a live honeypot; they are outputs, not source.
Caddyfile.deployed
docker-compose.deployed.yml

__pycache__/
*.pyc
.pytest_cache/
.DS_Store
.venv/
